# Copy to .env.local for local overrides. API_ORIGIN defaults to
# http://localhost:8080 (the jmeet Spring Boot backend) if unset — see
# next.config.mjs.
API_ORIGIN=http://localhost:8080

# Browser-reachable origins: inlined at build time, so unlike API_ORIGIN
# (server-side only, used for the /api/* rewrite proxy) these can't proxy
# through Next: STOMP's native WebSocket and LiveKit's media connection both
# go straight from the browser to their own servers.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
