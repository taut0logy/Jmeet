### Domains (must already point at this server)
APP_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=livekit.example.com
MEDIA_DOMAIN=media.example.com

### Container image
IMAGE_TAG=latest

### Database
DATABASE_URL=jdbc:postgresql://postgres:5432/jmeet
DATABASE_USER=jmeet
DATABASE_PASSWORD=change-me

### Redis
REDIS_URL=redis://redis:6379/0

### RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=jmeet
RABBITMQ_PASSWORD=change-me
RABBITMQ_ERLANG_COOKIE=change-me-to-a-long-random-string

### Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

### Google OAuth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

### App
CLIENT_BASE_URL=https://meet.example.com
JOIN_TOKEN_SECRET=change-me-to-a-random-32-plus-byte-string

### Object storage (self-hosted MinIO, published through Caddy at MEDIA_DOMAIN)
STORAGE_DRIVER=s3
S3_BUCKET=jmeet
S3_REGION=us-east-1
S3_ENDPOINT=https://media.example.com
S3_PATH_STYLE=true
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

### LiveKit (self-hosted)
LIVEKIT_HOST=https://livekit.example.com
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-random-32-plus-byte-string

### Meeting behavior
MEETING_MAX_PARTICIPANTS=30
MEETING_SINGLE_MEETING_ENABLED=true
MEETING_SCREEN_SHARE_MAX_CONCURRENT=2
MEETING_CHAT_SNAPSHOT_LIMIT=50
MEETING_REMINDER_LEAD_TIME=15m
MEETING_DURATION_WARNING=5m
MEETING_AUTO_END_GRACE=5m

### Recording (egress writes to MinIO over the internal docker network)
S3_EGRESS_ENDPOINT=http://minio:9000
RECORDING_LAYOUT_URL=https://meet.example.com/egress
RECORDING_MAX_DURATION=2h

### Observability - Grafana Alloy forwards to Grafana Cloud
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-xx-xxx.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=change-me
GRAFANA_CLOUD_API_KEY=change-me
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-xx-xxx.grafana.net/api/prom/push
